# 依赖
node_modules/

# 生成产物（JSON / GIF / PNG 序列等）
out/

# 字体文件体积大，由脚本按需下载，不入库
data/fonts/

# 第三方数据缓存（KanjiVG、字体解压等）
data/kanjivg/
data/vendor/

# 全量评测数据（体积大；只提交抽样清单）
test/gold/full/

# 下载/临时缓存
.cache/
tmp/
*.tgz
*.zip

# 测试覆盖率
coverage/
.nyc_output/

# 日志与环境变量
*.log
npm-debug.log*
.env
.env.*

# 编辑器与系统文件
.idea/
.vscode/
.DS_Store
Thumbs.db
